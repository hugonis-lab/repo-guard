# 12-Factor configuration template for repo-guard
# Export these environment variables or load them in your shell profile.

# Path to machine-local private patterns JSON (0600 permissions, outside Git)
# Defaults to $XDG_CONFIG_HOME/repo-guard/private-patterns.json
REPO_GUARD_CONFIG=""

# Optional override for the repo-guard executable invoked by global Git hooks
REPO_GUARD_BIN="repo-guard"
